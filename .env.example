# Spotify app Client ID (from developer.spotify.com/dashboard). Not a secret, safe to ship.
VITE_SPOTIFY_CLIENT_ID=

# Supabase project (Settings → API). The publishable/anon key is public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Who people contact for an account / Spotify access (shown on the sign-in screen)
VITE_OWNER_NAME=
VITE_OWNER_EMAIL=
VITE_OWNER_WHATSAPP=
